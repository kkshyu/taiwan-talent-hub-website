# 正式站 Zeabur 環境變數範本
# 匯入：先選定服務，再 `zeabur variable env -f zeabur.env.example`（或於面板貼上）
# 機敏值（<...>）由你自行填入／更新；PORT 由 Zeabur 自動注入，勿設。

# ── 非機敏（可直接使用） ─────────────────────────────
PUBLIC_ORIGIN=https://www.emoji.tw
WEB_ORIGINS=https://www.emoji.tw,https://emoji.tw
MEMBERSHIP_START=2026-11-01
SALE_END=2026-12-31
MAX_PARTICIPANTS=100

# ── 後台管理：改以 Google 帳號認定超級管理員（無登入代碼）──
# 預設超管為 us@twouring.com；如需更改才設此變數。超管可於後台指派其他管理員。
SUPER_ADMIN_EMAIL=us@twouring.com

# ── 機敏（自行填入） ─────────────────────────────────
APP_SECRET=<32+ 字元隨機字串>
PII_KEY=<個資加密金鑰，建議獨立於 APP_SECRET>
ACCESS_QR_SECRET=
ACCESS_DOOR_SECRET=
EVENT_QR_SECRET=<活動票券 QR 簽章；可與 ACCESS_QR_SECRET 分開>
# AI agent 管理 API 金鑰（openssl rand -hex 32）；等同超管權限，端點清單見 docs/API.md
# 未設＝停用 agent 管理；少於 24 字元會被忽略；換一組即撤銷舊金鑰
ADMIN_API_KEY=<64 字元隨機字串>

# 一律取自 Stripe「Emoji 言文字」帳號 acct_1Ts2y95NXMKDsl40；不得混用其他帳號。
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<...>

# ── IG 自動發佈（spec：docs/superpowers/specs/2026-08-17-ig-autopublish-design.md）──
# Meta App「Instagram API with Instagram Login」；App Secret 僅供 OAuth 用，發文流程不需要。
# IG_USER_ID：後台 Generate token 時一併顯示的 Instagram 帳號數字 ID
# IG_ACCESS_TOKEN：初始長期 token（60 天）；系統每日自動續期並存 DB，之後以 DB 為準
IG_AUTOPUBLISH=1
# IG_USER_ID 可留空（預設 me＝token 本人；多帳號才需指定）
IG_ACCESS_TOKEN=<長期 access token>
# 額外禁用字（逗號分隔；內建：住宿,入住,過夜,旅館,hotel,共居,床位）
# IG_BANNED_WORDS=
# AI 補產器（每週日 20:00；未設 key 即停用）
ANTHROPIC_API_KEY=<sk-ant-...>
# IG 發文圖與素材存 MinIO（同專案 minio 服務；未設則 fallback 存 uploads/social/）
S3_ENDPOINT=http://minio.zeabur.internal:9000
S3_PUBLIC_BASE=https://emoji-minio.zeabur.app
S3_ACCESS_KEY=minio
S3_SECRET_KEY=<minio PASSWORD>
S3_BUCKET=ig-media

# ── 資料庫 ───────────────────────────────────────────
# 於 Zeabur 建立 Postgres 服務後，將其連線字串綁到此變數
# （server.js 亦接受 POSTGRES_CONNECTION_STRING 或 POSTGRES_* 個別變數）
DATABASE_URL=<postgres://user:pass@host:5432/dbname>
